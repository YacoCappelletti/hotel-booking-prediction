{
  "random_seed": 42,
  "split_ratios": {
    "train": 0.70,
    "validation": 0.15,
    "test": 0.15
  },
  "cv": {
    "folds": 5,
    "shuffle": true
  },
  "primary_metric": "pr_auc",
  "candidate_models": {
    "classification": [
      "LogisticRegression",
      "DecisionTreeClassifier",
      "RandomForestClassifier",
      "GradientBoostingClassifier"
    ],
    "regression": [
      "LinearRegression",
      "DecisionTreeRegressor",
      "RandomForestRegressor",
      "GradientBoostingRegressor"
    ]
  },
  "hyperparameter_grids": {
    "LogisticRegression": {"C": [0.1, 1.0, 10.0], "max_iter": [1000]},
    "DecisionTreeClassifier": {"max_depth": [5, 10, 15, null], "min_samples_leaf": [5, 20, 50]},
    "RandomForestClassifier": {"n_estimators": [200, 400], "max_depth": [10, 15, null], "min_samples_leaf": [2, 10]},
    "GradientBoostingClassifier": {"n_estimators": [200, 400], "learning_rate": [0.05, 0.1], "max_depth": [3, 5]}
  }
}
